# Скопіюйте у .env і заповніть. Файл .env не комітиться.

# Токен від @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш числовий Telegram ID (дізнатися: @userinfobot)
TELEGRAM_OWNER_ID=
# Ключ Anthropic API (console.anthropic.com)
ANTHROPIC_API_KEY=
# Модель для аналізу. claude-opus-5-5 — найкраща якість;
# claude-sonnet-5-5 — удвічі дешевша і швидша.
ANTHROPIC_MODEL=claude-opus-5-5
