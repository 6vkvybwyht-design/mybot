# Скопіюйте у .env і заповніть. Файл .env не комітиться.

# Токен від @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш числовий Telegram ID (дізнатися: @userinfobot)
TELEGRAM_OWNER_ID=
# Ключ Anthropic API (console.anthropic.com)
ANTHROPIC_API_KEY=
# Модель для аналізу. claude-opus-5-5 — найкраща якість;
# claude-sonnet-5-5 — удвічі дешевша і швидша.
ANTHROPIC_MODEL=claude-opus-5-5

# MetaTrader 5 (Bybit TradFi). Радимо пароль ІНВЕСТОРА — він дає лише читання.
# Номер рахунку MT5
MT5_LOGIN=
MT5_PASSWORD=
# Сервер брокера, напр. Bybit-Live-6
MT5_SERVER=
# Необов'язково: шлях до terminal64.exe, якщо терміналів кілька або він не знаходиться сам
MT5_PATH=
